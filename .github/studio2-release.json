{
  "studio2" : true,
  "default_keyset": "test.demo-tutorials",
  "prebuild_cmd": ".github/release_prebuild.sh",
  "build_cmd": "./quickbuild.sh",

  "artifacts": [
    {
      "id": "kos-class-thermostat",
      "filename": "thermostat/java/class/thermostat/app/target/kos-class-thermostat-${KOS_STD_VERSION_REGEX}.kab",
      "artifactstore": "defaultArtifact",
      "qualifier": "any"
    },
    {
      "id": "kos-class-thermostat-simulator",
      "filename": "thermostat/java/class/simulator/target/kos-class-thermostat-simulator-${KOS_STD_VERSION_REGEX}.kab",
      "artifactstore": "defaultArtifact",
      "qualifier": "any"
    },
    {
      "id": "kos-class-thermostat-ui",
      "filename": "thermostat/ui/dist/archives/packages/thermostat-ui/thermostat-ui.kab",
      "artifactstore": "defaultArtifact",
      "qualifier": "any"
    }
  ]
}

