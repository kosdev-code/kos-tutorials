      "qualifier": "any"
    },

    {
      "id": "kosdev-tutorial-thermostat",
      "filename": "thermostat/java/thermostat/app/target/tutorial-thermostat.java.thermostat.app-${KOS_STD_VERSION_REGEX}.kab",
      "artifactstore": "default_artifact_store",
      "qualifier": "any"
    },
    {
      "id": "kosdev-tutorial-thermostat-simulator",
      "filename": "thermostat/java/simulator/target/tutorial-thermostat.java.simulator-${KOS_STD_VERSION_REGEX}.kab",
      "artifactstore": "default_artifact_store",
      "qualifier": "any"
    },

    {
      "id": "kosdev-tutorial-arduino",
      "filename": "arduino/java/target/tutorial-arduino.java-${KOS_STD_VERSION_REGEX}.kab",
